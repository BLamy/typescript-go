// Finding 2: mutually recursive rethrow wrappers, no TS7022, still enforced.
function a(): void { try { b(); } catch (e) { throw e; } }
>a : () => void throws unknown
>b() : void
>b : () => void throws unknown
>e : unknown
>e : unknown

function b(): void { try { a(); } catch (e) { throw e; } throw new E1(); }
>b : () => void throws unknown
>a() : void
