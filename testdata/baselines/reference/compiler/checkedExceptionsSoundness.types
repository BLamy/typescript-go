>ctor : typeof LateConstructor
>LateConstructor : typeof LateConstructor

retainConstructor(LateConstructor);
>retainConstructor(LateConstructor) : void
>retainConstructor : (ctor: typeof LateConstructor) => void throws never
>LateConstructor : typeof LateConstructor

function lateFactory() {
