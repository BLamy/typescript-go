// One unknown source poisons catch precision instead of allowing an optimistic
// tracked-only type.
function mixedCatch(): void throws never {
>mixedCatch : () => void throws never

    try {
        tracked();
>tracked() : void
>tracked : () => void throws "tracked"

        legacy();
>legacy() : void
>legacy : () => void throws unknown

    } catch (e) {
>e : unknown

        const unsound: "tracked" = e;
>unsound : "tracked"
>e : unknown
    }
}

