>accessor.value : number
>accessor : { readonly value: number; }
>value : number
}

// Getter and setter effects are distinct: reading only executes the getter,
// while assigning executes the setter.
const splitAccessor = {
>splitAccessor : { value: number; }
>{    get value(): number { return 1; },    set value(next: number) { throw "setter"; },} : { value: number; }

    get value(): number { return 1; },
>value : number
>1 : 1

    set value(next: number) { throw "setter"; },
>value : number
>next : number
>"setter" : "setter"

};
function readsSafeGetter(): number throws never {
>readsSafeGetter : () => number throws never

    return splitAccessor.value;
>splitAccessor.value : number
>splitAccessor : { value: number; }
>value : number
}
function writesThrowingSetter(): void throws never {
>writesThrowingSetter : () => void throws never

    splitAccessor.value = 2;
>splitAccessor.value = 2 : 2
>splitAccessor.value : number
>splitAccessor : { value: number; }
>value : number
>2 : 2
}

