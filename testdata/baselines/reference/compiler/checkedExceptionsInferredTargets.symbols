// A mutable binding whose type carries *inferred* throws constrains
// reassignment: call sites of `f` see the initializer's inferred set (E1),
// so assigning a wider thrower must fail.
let f = (x?: number) => { if (x) throw new E1(); };
>f : Symbol(f, Decl(checkedExceptionsInferredTargets.ts, 8, 3))
>x : Symbol(x, Decl(checkedExceptionsInferredTargets.ts, 8, 9))
>x : Symbol(x, Decl(checkedExceptionsInferredTargets.ts, 8, 9))
>E1 : Symbol(E1, Decl(checkedExceptionsInferredTargets.ts, 0, 0))

f = throwsE2; // error
>f : Symbol(f, Decl(checkedExceptionsInferredTargets.ts, 8, 3))
>throwsE2 : Symbol(throwsE2, Decl(checkedExceptionsInferredTargets.ts, 3, 13))

f = (x?: number) => { if (x) throw new E1(); }; // ok: same set
>f : Symbol(f, Decl(checkedExceptionsInferredTargets.ts, 8, 3))
>x : Symbol(x, Decl(checkedExceptionsInferredTargets.ts, 10, 5))
>x : Symbol(x, Decl(checkedExceptionsInferredTargets.ts, 10, 5))
>E1 : Symbol(E1, Decl(checkedExceptionsInferredTargets.ts, 0, 0))

